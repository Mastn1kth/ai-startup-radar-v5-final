# === НАСТРОЙКИ ===
# ВСТАВЬ СЮДА СВОИ ТОКЕНЫ:
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here

# AI (Ollama - бесплатно, локально на твоем ПК)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# База данных (автоматически)
DATABASE_URL=postgresql+asyncpg://radar:radar_secret_2026@postgres:5432/ai_startup_radar
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Безопасность
# Сгенерируйте свой: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=radar-secret-key-2026
DEFAULT_ADMIN_EMAIL=admin@radar.local
# Оставьте пустым для генерации рандомного пароля при первом запуске
DEFAULT_ADMIN_PASSWORD=admin123

# CORS (разрешённые домены через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Приложение
APP_NAME=AI Startup Radar
APP_VERSION=1.0.0
DEBUG=False

# Скрапинг
SCRAPE_INTERVAL_MINUTES=120
MAX_CONCURRENT_SCRAPERS=4
REQUEST_TIMEOUT=30

# Скоринг (минимум для уведомлений в TG)
MIN_STARTUP_SCORE_FOR_TELEGRAM=70
MIN_RUSSIA_SCORE_FOR_ALERT=60